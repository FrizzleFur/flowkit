{
  "title": "六原则判定链——一条精心排布的短路电路",
  "version": 2,
  "flow": {
    "nodes": [
      { "id": "find", "label": "评审发现进来", "x": 30, "y": 4, "w": 180, "h": 30, "type": "rect" },
      { "id": "p1", "label": "P1 有行业标准?", "x": 30, "y": 64, "w": 180, "h": 30, "type": "rect" },
      { "id": "p2", "label": "P2 风险分级", "x": 30, "y": 124, "w": 180, "h": 30, "type": "rect" },
      { "id": "p3", "label": "P3 与已批决策冲突?", "x": 30, "y": 184, "w": 180, "h": 30, "type": "rect" },
      { "id": "p4", "label": "P4 前瞻性建议?", "x": 30, "y": 244, "w": 180, "h": 30, "type": "rect" },
      { "id": "p5", "label": "P5 安全相关?", "x": 30, "y": 304, "w": 180, "h": 30, "type": "rect" },
      { "id": "p6", "label": "P6 可逆性评估", "x": 30, "y": 364, "w": 180, "h": 30, "type": "rect" },
      { "id": "auto", "label": "AUTO_APPROVED（记录）", "x": 300, "y": 64, "w": 200, "h": 30, "type": "rect" },
      { "id": "blocked", "label": "BLOCKED（阻塞）", "x": 300, "y": 184, "w": 170, "h": 30, "type": "rect" },
      { "id": "taste", "label": "TASTE_DECISION（上浮）", "x": 300, "y": 304, "w": 190, "h": 30, "type": "rect" },
      { "id": "pass", "label": "默认通过（未命中任何原则）", "x": 30, "y": 424, "w": 220, "h": 30, "type": "rect" }
    ],
    "edges": [
      { "from": "find", "to": "p1" },
      { "from": "p1", "to": "auto", "label": "命中" },
      { "from": "p1", "to": "p2", "label": "否" },
      { "from": "p2", "to": "blocked", "label": "CRITICAL" },
      { "from": "p2", "to": "taste", "label": "HIGH" },
      { "from": "p2", "to": "p3", "label": "MED/LOW" },
      { "from": "p3", "to": "auto", "label": "保持已批" },
      { "from": "p3", "to": "p4", "label": "否" },
      { "from": "p4", "to": "taste", "label": "YAGNI" },
      { "from": "p4", "to": "p5", "label": "否" },
      { "from": "p5", "to": "taste", "label": "安全" },
      { "from": "p5", "to": "p6", "label": "否" },
      { "from": "p6", "to": "taste", "label": "例外/≥3文件" },
      { "from": "p6", "to": "pass", "label": "未命中" }
    ]
  },
  "messagesPanels": [
    { "id": "main", "title": "判定过程 messages[]" }
  ],
  "steps": [
    { "title": "发现进来",
      "desc": "面板评审综合后可能产出 20+ 条发现——每一条都要过这条短路电路，命中即停，不再继续。",
      "clear": ["main"],
      "on": ["find"],
      "append": { "main": [ { "role": "system", "label": "发现：采集脚本缺少输入验证" } ] } },
    { "title": "P1 · 行业标准优先",
      "desc": "摆最前因为行业标准答案最无争议——命中即 AUTO_APPROVED 并记录，走得越靠前自动化越安全。",
      "on": ["find", "p1", "auto"],
      "edgesOn": ["find>p1", "p1>auto"],
      "append": { "main": [ { "role": "tool_result", "label": "缺输入验证有明确行业答案 → AUTO_APPROVED（静默入 findings 可追溯）" } ] } },
    { "title": "P2 · 风险分级",
      "desc": "CRITICAL 直接 BLOCKED；HIGH 上浮。注意安全类不走 P1 自动采纳——统一先过 P2 分级。",
      "on": ["find", "p2", "blocked"],
      "edgesOn": ["find>p1", "p1>p2", "p2>blocked"],
      "append": { "main": [ { "role": "tool_result", "label": "API 密钥可能进日志 → CRITICAL → BLOCKED（安全问题要么很重要么上浮，没有静默自动修）" } ] } },
    { "title": "P3 · 已批决策一致性",
      "desc": "与已确认决策冲突时保持已批并记录——评审不能悄悄推翻用户拍过板的东西。",
      "on": ["find", "p3", "auto"],
      "edgesOn": ["find>p1", "p1>p2", "p2>p3", "p3>auto"],
      "append": { "main": [ { "role": "tool_result", "label": "已定 Redis，评审建议改 Memcached → 保持已批（记录冲突）" } ] } },
    { "title": "P4/P5 · YAGNI 与安全上浮",
      "desc": "前瞻性建议标 [YAGNI] 上浮；安全相关 MEDIUM 及以上一律 [SECURITY] 上浮——默认归宿是用户。",
      "on": ["find", "p4", "p5", "taste"],
      "edgesOn": ["p3>p4", "p4>taste", "p4>p5", "p5>taste"],
      "append": { "main": [ { "role": "tool_result", "label": "「为微服务化预留接口」→ [YAGNI]；「加 rate limiting」→ [SECURITY]" } ] } },
    { "title": "P6 · 可逆性与例外条款",
      "desc": "数文件之前先读例外——schema / API 协议 / 公共签名变更不论文件数一律上浮 [IRREVERSIBLE]。",
      "on": ["find", "p6", "taste"],
      "edgesOn": ["p5>p6", "p6>taste"],
      "append": { "main": [ { "role": "tool_result", "label": "schema 变更影响 2 个文件 → 例外条款命中 → [IRREVERSIBLE] 上浮" } ] } },
    { "title": "默认通过",
      "desc": "走完全链没命中任何原则 → 默认 AUTO_APPROVED——这条是刻意的：拿不准要不要上浮的常规项，不配打断用户。",
      "on": ["find", "p6", "pass"],
      "edgesOn": ["p6>pass"],
      "append": { "main": [ { "role": "final", "label": "三出口只有 AUTO_APPROVED / TASTE_DECISION / BLOCKED——AUTO_FIX 在现行体系里不存在" } ] } }
  ]
}
